{
  "manifest_version": 2,
  "name": "Compact Everything",
  "description": "compacts every folder in every account and shows how much disk space was recovered",
  "version": "1.0",
  "author": "Stefan Gabos",
  "homepage_url": "https://github.com/stefangabos/compact-everything",
  "browser_specific_settings": {
    "gecko": {
      "id": "compact-everything@stefangabos.github.io",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png"
  },
  "browser_action": {
    "default_title": "compact everything",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/toolbar-dark.svg",
    "theme_icons": [
      {
        "light": "icons/toolbar-light.svg",
        "dark": "icons/toolbar-dark.svg",
        "size": 16
      },
      {
        "light": "icons/toolbar-light.svg",
        "dark": "icons/toolbar-dark.svg",
        "size": 32
      }
    ]
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": ["storage"],
  "experiment_apis": {
    "compactor": {
      "schema": "api/compactor/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["compactor"]],
        "script": "api/compactor/implementation.js"
      }
    }
  }
}
